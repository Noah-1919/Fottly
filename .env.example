# Copy this file to .env and adjust the values for your S3 provider
# (AWS S3, Cloudflare R2, MinIO...). The defaults below match the "minio"
# service in docker-compose.yml.

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fottly
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Required for MinIO and other backends that don't support virtual-hosted
# style. On real AWS S3, set this to "false".
S3_FORCE_PATH_STYLE=true

# Key required in the "Authorization: Bearer <API_KEY>" header for file
# management routes (/files/...). Delivery routes (/t/...) are public.
# Change this to your own value before deploying.
API_KEY=dev-secret-key

# Maximum request body size, in megabytes (applies to file uploads).
MAX_UPLOAD_SIZE_MB=25

# Global rate limit, per IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
